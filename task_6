#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int n = 10;
    int arr[n];

    cout << "Generated array: ";
    for (int i = 0; i < n; i++) {
        arr[i] = rand() % 7 - 3; // числа від -3 до 3
        cout << arr[i] << " ";
    }
    cout << endl;

    int zeroIndex = -1;
    for (int i = 0; i < n; i++) {
        if (arr[i] == 0) {
            zeroIndex = i;
            break;
        }
    }

    if (zeroIndex != -1) {
        cout << "First zero element found at index: " << zeroIndex
             << " (position " << zeroIndex + 1 << ")" << endl;
    } else {
        cout << "The array does not contain zero elements." << endl;
    }

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
