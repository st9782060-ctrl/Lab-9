#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int n = 12;
    int arr[n];

    cout << "Generated array: ";
    for (int i = 0; i < n; i++) {
        arr[i] = rand() % 101 - 50; // числа від -50 до 50
        cout << arr[i] << " ";
    }
    cout << endl;

    int A;
    cout << "Enter number A: ";
    cin >> A;

    int count = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] > A) {
            count++;
        }
    }

    cout << "Count of elements greater than " << A << ": " << count << endl;

    cout << "Press Enter to exit...";
    cin.ignore();
    cin.get();
    return 0;
}
