#include <iostream>
#include <cstdlib>
#include <ctime>

using namespace std;

int main() {
    srand(static_cast<unsigned int>(time(0)));

    const int n = 10;
    int arr[n];

    // Заповнюємо масив різними випадковими числами від -50 до 50
    for (int i = 0; i < n; i++) {
        int candidate;
        bool unique;
        do {
            unique = true;
            candidate = rand() % 101 - 50;
            for (int j = 0; j < i; j++) {
                if (arr[j] == candidate) {
                    unique = false;
                    break;
                }
            }
        } while (!unique);
        arr[i] = candidate;
    }

    cout << "Original array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    int minIndex = 0;
    int maxIndex = 0;
    for (int i = 1; i < n; i++) {
        if (arr[i] < arr[minIndex]) minIndex = i;
        if (arr[i] > arr[maxIndex]) maxIndex = i;
    }

    cout << "Min element: " << arr[minIndex] << ", Max element: " << arr[maxIndex] << endl;

    // Міняємо місцями найменший і найбільший елементи
    int temp = arr[minIndex];
    arr[minIndex] = arr[maxIndex];
    arr[maxIndex] = temp;

    cout << "Modified array: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    cout << "Press Enter to exit...";
    cin.get();
    return 0;
}
